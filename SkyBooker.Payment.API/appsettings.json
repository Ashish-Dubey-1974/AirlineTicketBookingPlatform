{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "your-super-secret-jwt-key-here-should-be-at-least-32-characters-long",
    "Issuer": "SkyBooker.Auth.API",
    "Audience": "SkyBooker.Clients",
    "ExpiryHours": "24"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=SkyBookerPaymentDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "ServiceUrls": {
    "BookingService": "http://localhost:5010"
  },
  "Razorpay": {
    "KeyId": "rzp_test_your_key_id",
    "KeySecret": "your_key_secret",
    "WebhookSecret": "your_webhook_secret"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5000", "https://localhost:5001", "http://localhost:4200" ]
},
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    }
  }
}