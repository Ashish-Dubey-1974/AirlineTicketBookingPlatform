{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "your-super-secret-jwt-key-here-should-be-at-least-32-characters-long",
    "Issuer": "SkyBooker.Auth.API",
    "Audience": "SkyBooker.Clients",
    "ExpiryHours": "24"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=SkyBookerNotificationDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "ServiceUrls": {
    "AuthService": "http://localhost:5097",
    "FlightService": "http://localhost:5009",
    "BookingService": "http://localhost:5010",
    "PassengerService": "http://localhost:5012"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest"
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "noreply@skybooker.com",
    "SenderName": "SkyBooker"
  },
  "Twilio": {
    "AccountSid": "your_account_sid",
    "AuthToken": "your_auth_token",
    "FromNumber": "+1234567890"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5000", "https://localhost:5001" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    }
  }
}